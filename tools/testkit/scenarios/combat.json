[
 {
  "name": "toolbox fight ends in a death with its killer",
  "steps": [
   {
    "do": "arena",
    "w": 7,
    "h": 7,
    "save": "arena"
   },
   {
    "do": "spawn",
    "type": "/mob/living/carbon/human",
    "at": "arena:${arena.id}",
