    "intent": "harm"
   },
   {
    "do": "use",
    "user": "${a.0.ref}",
    "item": "held",
    "target": "${b.0.ref}",
    "repeat": 12,
    "every": 0.8,
    "save": "fight"
   },
   {
    "do": "damage",
    "mob": "${b.0.ref}",
    "brute": 200
