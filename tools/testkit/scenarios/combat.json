    "expect": "event",
    "kinds": [
     "attack"
    ],
    "match": "${b.0.ref}"
   },
   {
    "expect": "var",
    "ref": "${b.0.ref}",
    "var": "stat",
    "value": 3,
    "within": 5
   }
  ]
 },
 {
  "name": "a human in vacuum dies of it",
  "steps": [
