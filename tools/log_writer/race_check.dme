// The log writer's thread opens new files while the game's thread copies, makes and deletes files (tools/log_writer/race_check.sh).
// BYOND on Linux moves the working folder for a moment inside fcopy, text2file, file() and fdel, so a library that opens
// "data/..." on its own thread right then puts the file somewhere else. Every file should end up in data/race_check/.
// Params: lib=<library path> n=<files> out=<result file>

/world
	loop_checks = FALSE

/world/New()
	..()
	spawn(1)
		run_race()

/proc/run_race()
	var/lib = world.params["lib"]
	var/n = text2num(world.params["n"]) || 800
	var/out = world.params["out"] || "race_result.txt"
	var/dir = "data/race_check/"
	for(var/i in 1 to n)
		call_ext(lib, "log_write")("[dir]f[i].log", "line [i]", "true")
		var/tmp = "[dir]tmp/t[i].txt"
		text2file("x", tmp)
		fcopy(tmp, "[dir]tmp/c[i].txt")
		var/F = file("[dir]tmp/w[i].txt")
		F << "y"
		fdel(tmp)
	var/close = call_ext(lib, "log_close_all")()
	var/status = call_ext(lib, "log_status")()
	var/missing = 0
	for(var/i in 1 to n)
		if(!fexists("[dir]f[i].log"))
			missing++
	text2file("n=[n] missing=[missing] status=[status][close ? " close=[close]" : ""]", out)
	shutdown()
